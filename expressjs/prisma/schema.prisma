generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  phone        String?
  role         String        @default("PATIENT")
  status       String        @default("ACTIVE")
  sessions     AuthSession[]
  medicalRecords MedicalRecord[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model AuthSession {
  id        String    @id @default(uuid())
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model Specialty {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  doctors     DoctorSpecialty[]
  services    Service[]

  @@index([status])
}

model Doctor {
  id             String             @id @default(uuid())
  fullName       String
  phone          String?
  email          String?
  licenseNumber  String?            @unique
  title          String?
  bio            String?
  avatarUrl      String?
  status         String             @default("ACTIVE")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  specialties    DoctorSpecialty[]
  schedules      WorkingSchedule[]
  exceptions     ScheduleException[]
  appointments   Appointment[]
}

model Service {
  id              String   @id @default(uuid())
  specialtyId     String?
  name            String
  slug            String   @unique
  description     String?
  durationMinutes Int
  price           Int
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  specialty       Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  appointments    Appointment[]

  @@index([specialtyId])
  @@index([status])
}

model WorkingSchedule {
  id                  String   @id @default(uuid())
  doctorId            String
  dayOfWeek           Int
  startTime           String
  endTime             String
  slotDurationMinutes Int
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  status              String   @default("ACTIVE")
  doctor              Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek, status])
  @@unique([doctorId, dayOfWeek, startTime, effectiveFrom])
}

model ScheduleException {
  id            String   @id @default(uuid())
  doctorId      String
  exceptionDate DateTime
  startTime     String?
  endTime       String?
  type          String
  reason        String?
  doctor        Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, exceptionDate])
}

model Appointment {
  id              String   @id @default(uuid())
  bookingCode     String   @unique
  patientId       String?
  patientName     String
  patientPhone    String
  patientEmail    String?
  doctorId        String
  specialtyId     String?
  serviceId       String
  appointmentDate DateTime
  startTime       String
  endTime         String
  status          String   @default("PENDING")
  patientNote     String?
  staffNote       String?
  cancelReason    String?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  doctor          Doctor   @relation(fields: [doctorId], references: [id])
  service         Service  @relation(fields: [serviceId], references: [id])
  statusHistory   AppointmentStatusHistory[]

  @@index([doctorId, appointmentDate, startTime, status])
  @@index([bookingCode])
  @@unique([doctorId, appointmentDate, startTime])
}

model AppointmentStatusHistory {
  id            String   @id @default(uuid())
  appointmentId String
  fromStatus    String?
  toStatus      String
  reason        String?
  changedBy     String?
  createdAt     DateTime @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
}

model DoctorSpecialty {
  doctorId    String
  specialtyId String
  doctor      Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([doctorId, specialtyId])
  @@index([specialtyId])
}

model MedicalRecord {
  id             String   @id @default(uuid())
  userId         String
  weight         Float?
  height         Float?
  bloodPressure  String?
  heartRate      Int?
  temperature    Float?
  allergies      String?
  medicalHistory String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
